# Database
POSTGRES_DB=beyou
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1516
POSTGRES_PORT=5490

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database connection (for Spring app inside Docker)
DATABASE_URL=jdbc:postgresql://postgres:5432/beyou
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=1516
DATABASE_E2E_URL=jdbc:postgresql://postgres:5432/beyou_e2e

# Auth
TOKEN_SECRET=change-me-to-a-32-char-or-longer-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_PATTERN=*

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_MINUTES=5

# URLs
FRONTEND_URL=http://localhost:3000/
OAUTH_GOOGLE_URL=https://oauth2.googleapis.com/token
USER_INFO_GOOGLE_URL=https://www.googleapis.com/oauth2/v2/userinfo

ACTIVE_PROFILE=dev

# Docs Import
DOCS_IMPORT_REPO_OWNER=AndDev741
DOCS_IMPORT_REPO_NAME=beyou-arch-design
DOCS_IMPORT_PATH=architecture
DOCS_IMPORT_DESIGN_PATH=design
DOCS_IMPORT_TOKEN=
DOCS_IMPORT_SECRET=something

# Monitoring
MANAGEMENT_PORT=9091
MANAGEMENT_ADDRESS=0.0.0.0
ACTUATOR_ENDPOINTS=*
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# REQUIRED — no default. An empty value used to become the literal `admin`.
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
# Alloy's debugging UI (log-collection pipeline health, discovered containers).
# Loopback-only by default, like Prometheus. Loki itself has no host port at
# all — logs are read through Grafana, pushed by Alloy, both over beyou_net.
ALLOY_PORT=12345

# GlitchTip (error telemetry — only used by docker-compose.monitoring.yml)
# REQUIRED whenever the monitoring stack is started. Generate with:
#   openssl rand -hex 32
# Never commit the real value.
GLITCHTIP_SECRET_KEY=
# Host port for the GlitchTip UI / event ingest endpoint.
GLITCHTIP_PORT=8000
# Public base URL of this GlitchTip instance, including the scheme. Used to
# build links in alert emails, so it must match how you actually reach the UI.
GLITCHTIP_DOMAIN=http://localhost:8000
# Outbound SMTP for new-issue and uptime/heartbeat alerts. GlitchTip takes a
# single dj-style URL rather than separate host/port/user/pass variables.
#
# LOCAL DEV DEFAULT — leave it. consolemail:// hands mail to Django's console
# backend, which prints the full message to the container log and sends nothing.
# That is deliberate: a dev machine that starts mailing a real inbox every time
# somebody reloads a broken page teaches everyone to filter the alerts away.
#   docker logs -f beyou-dev-env-glitchtip-1
#
# DEPLOYED STACK — compose the URL from the SAME SMTP account the backend
# already uses (MAIL_* above / Beyou-backend-spring/envExample). Nothing new to
# provision, and that account is known to deliver.
#
#   smtp+tls://<MAIL_USERNAME>:<MAIL_PASSWORD>@<MAIL_HOST>:<MAIL_PORT>
#
# Use the `smtp+tls` scheme, not `smtp`: it is the one that sets EMAIL_USE_TLS,
# i.e. STARTTLS on a submission port — which is what the backend does
# (`spring.mail.properties.mail.smtp.starttls.enable: true`, auth on). For an
# implicit-TLS port (usually 465) use `smtp+ssl` instead. Plain `smtp://`
# authenticates in cleartext.
#
# Four things that silently break this:
#   1. The username AND password are both URL components. Percent-encode
#      anything reserved in either — @ : / ? # and a literal % — or the URL
#      parses into the wrong host and every send fails. This bites the username
#      first: it is usually an address, and an unencoded @ truncates the URL
#      there (write it %40). App passwords with spaces: strip the spaces.
#   2. .env is not a shell, but Compose DOES expand $VAR here. A password
#      containing $ needs it doubled ($$).
#   3. Most providers reject a From that is not the authenticated mailbox, so
#      GLITCHTIP_FROM_EMAIL below has to match MAIL_FROM / MAIL_USERNAME.
#   4. Do NOT wrap this value in quotes, and do not copy quotes out of a
#      neighbouring MAIL_* line. Compose strips surrounding quotes from a value
#      it passes to a container, so a quoted password works elsewhere in this
#      file — but here the quotes land INSIDE the URL and travel to the server
#      as part of the password. The provider answers 535 Bad Credentials with a
#      value that looks correct in the file.
#
# Never commit the real value.
GLITCHTIP_EMAIL_URL=consolemail://
# Envelope From on alert mail. With a real GLITCHTIP_EMAIL_URL, set this to the
# same address as MAIL_FROM — a mismatch is rejected or silently spam-filed.
GLITCHTIP_FROM_EMAIL=glitchtip@localhost
# Where alerts are addressed. Empty = the first account you registered in the UI,
# which is already a valid recipient, so the stack alerts somebody by default.
# Set it to a shared ops mailbox for a deployed stack.
#
# Applied by ./scripts/bootstrap-glitchtip.sh, which is also the only thing that
# creates the alert rules. Changing this needs a re-run, not a restart.
#
# Read this before assuming it means "send only here": GlitchTip resolves e-mail
# recipients as *every user on the team that owns the project* — it never mails
# an address stored on the rule. So the bootstrap script makes this address a
# notification-only user (no password; use password-reset if it ever needs the
# UI) and adds it to the team. It is therefore ADDITIVE: the account you
# registered keeps receiving alerts too. To stop that, either remove that user
# from the team, or set their per-project alerts to Off in
# Settings -> Projects -> <project> -> Alerts.
GLITCHTIP_ALERT_EMAIL=
# Registration lock. The first account can always self-register; keep this
# False so nobody else can sign up afterwards.
GLITCHTIP_ENABLE_USER_REGISTRATION=False
# Which host:port the frontend uptime monitor probes, from INSIDE the compose
# network — so it is the container port, not the published one. Prod serves the
# built app through nginx (80), dev runs Vite directly (3000). The bootstrap
# script re-applies this on every run, so a wrong value here overwrites a right
# value in the collector — and an ABSENT value falls back to the script's prod
# default (frontend:80), leaving a dev stack's monitor permanently DOWN.
GLITCHTIP_FRONTEND_TARGET=frontend:3000

# Days of events/logs/uptime checks to keep before automatic cleanup.
GLITCHTIP_RETENTION_DAYS=30
# GlitchTip's own Postgres (separate from the Beyou database, not published to
# the host). Change the password for any non-local deployment.
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
# REQUIRED — the stack refuses to start without it, on purpose.
#
# Postgres reads this only when it first initialises the volume, so on an
# existing glitchtip_pg_data volume this value is inert: setting a new one does
# NOT rotate anything, it just stops the collector connecting.
#
# If you already have that volume, it holds whatever YOUR .env carried when the
# volume was first created — most likely the placeholder below, since README
# step 1 says to copy this file. The old `glitchtip` fallback applied only when
# the variable was unset or empty. Check before guessing.
#
# To actually rotate: set a new value AND delete the volume.
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db-password

# Heartbeat URL for the backend's scheduled snapshot job. The job runs hourly and
# checks in after every completed cycle; GlitchTip alerts when a check-in fails to
# arrive, which is how you learn the cron stopped (health checks stay green when a
# scheduler thread wedges). Leave empty to disable.
#
# Do not build this by hand: ./scripts/bootstrap-glitchtip.sh creates the
# heartbeat monitor and prints the URL ready to paste here. Its shape is
#   http://glitchtip:8000/api/0/organizations/<org-slug>/heartbeat_check/<endpoint-id>/
# — the in-network host, because the backend container cannot resolve localhost
# to the collector.
#
# The alert on a MISSED check-in only exists because the project's alert rule has
# uptime=True, which the same script sets. Without it this monitor goes red and
# tells nobody.
SNAPSHOT_HEARTBEAT_URL=
