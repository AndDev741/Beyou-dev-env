        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "description": "Creeping up = system prompt / icon catalog / context blobs growing, or longer tool chains. This is the early cost-regression signal.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "table",
      "title": "Tokens by model (24h)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (increase(gen_ai_client_token_usage_total{application=~\"$application\"}[24h]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "application": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Multiply by your provider price sheet for cost. DeepSeek = agent chat, OpenAI = routine drafts.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
