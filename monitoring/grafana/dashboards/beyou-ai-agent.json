      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(increase(gen_ai_client_token_usage_total{application=~\"$application\",gen_ai_token_type=\"total\"}[1h])) / (sum(increase(http_server_requests_seconds_count{application=~\"$application\",uri=\"/ai/agent/chats/{chatId}\",method=\"POST\"}[1h])) > 0)",
          "refId": "A",
          "legendFormat": "tokens/message"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
