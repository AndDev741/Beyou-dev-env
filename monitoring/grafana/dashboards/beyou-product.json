        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "beyou-postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT day AS time, sum(xp) AS \"xp\" FROM entity_xp_day WHERE $__timeFilter(day) AND owner_type = 'USER' GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
