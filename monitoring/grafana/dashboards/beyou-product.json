    {
      "type": "timeseries",
      "title": "Check-ins per day, by outcome",
      "description": "entity_check_day for habits and tasks, behavioral outcomes only (NOT_SCHEDULED / NOT_IN_ROUTINE are bookkeeping rows and would drown the chart). DONE is the healthy line; a growing MISSED is churn talking.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "beyou-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "beyou-postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT day AS time, outcome AS metric, count(*)::int AS value FROM entity_check_day WHERE $__timeFilter(day) AND owner_type IN ('HABIT','TASK') AND outcome IN ('DONE','SKIPPED','MISSED') GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "XP earned per day",
      "description": "entity_xp_day, USER rows only (category/habit/routine rows would triple-count the same actions).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "beyou-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
