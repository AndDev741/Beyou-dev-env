      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "beyou-postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at) AS time, coalesce(provider, 'unknown') AS metric, count(*)::int AS value FROM agent_message WHERE $__timeFilter(created_at) AND role = 'ASSISTANT' GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Users chatting with the AI per day",
      "description": "Distinct accounts sending at least one agent message that day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "beyou-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
