    },
    {
      "type": "timeseries",
      "title": "AI agent messages per day, by provider",
      "description": "Assistant turns from agent_message; provider says which LLM in the fallback chain actually answered.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "beyou-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
