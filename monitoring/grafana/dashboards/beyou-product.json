      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "beyou-postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', m.created_at) AS time, count(DISTINCT c.user_id)::int AS \"users\" FROM agent_message m JOIN chats c ON c.id = m.chat_id WHERE $__timeFilter(m.created_at) AND m.role = 'USER' GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "id": 18
    }
